# Copy this file to .env (same directory) and fill in the required values
# before running docker-compose.yml or scripts/start.sh.

# --- Database ---
POSTGRES_DB=moniqo
POSTGRES_USER=moniqo
# Required.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Only used by scripts/start.sh; docker-compose.yml builds this itself from
# the vars above and points it at its own `db` service instead.
DATABASE_URL=postgres://moniqo:${POSTGRES_PASSWORD}@localhost:5432/moniqo?sslmode=disable

# --- Backend ---
PORT=8080
BACKEND_PORT=8080
# Required. Generate with e.g. `openssl rand -base64 32`.
JWT_SECRET=
APP_ENV=production
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_MAX_AGE=720h
PASSWORD_RESET_TOKEN_TTL=1h
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
# Comma-separated list; defaults to APP_BASE_URL if unset.
CORS_ORIGINS=
BCRYPT_COST=12

# --- Email ---
# "smtp" or "noop" (noop logs instead of sending; do not use in production).
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@moniqo.in
EMAIL_FROM_NAME=Moniqo
# Required when EMAIL_PROVIDER=smtp.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_WORKER_INTERVAL=5s
EMAIL_WORKER_BATCH=10
EMAIL_BASE_BACKOFF=30s

# --- Web ---
WEB_PORT=3000
# Baked in at image build time for client-side code (NEXT_PUBLIC_* vars are
# inlined by webpack); only affects server-side code at container runtime.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- docker-compose.yml only ---
# Pins the moniqohq/moniqo-backend and moniqohq/moniqo-web image tags.
IMAGE_TAG=latest

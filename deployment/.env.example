# ── Production deployment env (Caddy + web + backend + db) ──
# Copy to deployment/.env and fill real values. Never commit deployment/.env.

# ── Cloudflare Tunnel ──
# Public TLS is terminated at Cloudflare's edge; cloudflared dials out (no inbound
# ports). Create the tunnel in the Cloudflare Zero Trust dashboard, copy its token
# here, and point its public hostname at the origin service http://caddy:80.
TUNNEL_TOKEN=change-me             # REQUIRED — tunnel token from the CF Zero Trust dashboard

# ── Public domain ──
# Used by the backend for absolute links / CORS. Must match the tunnel's public
# hostname configured in Cloudflare.
DOMAIN=moniqo.example.com

# ── Database ──
POSTGRES_DB=moniqo
POSTGRES_USER=moniqo
POSTGRES_PASSWORD=change-me        # REQUIRED — use a strong secret

# ── Auth ──
JWT_SECRET=change-me-long-random   # REQUIRED

# ── Email (real SMTP provider in production) ──
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.example.com   # REQUIRED
EMAIL_SMTP_PORT=587

# ── Web build arg (inlined into the bundle at build time) ──
# Relative path keeps the browser same-origin; Caddy routes /api/* to the backend.
NEXT_PUBLIC_API_URL=/api/v1

# ─────────────────────────────────────────────
# Moniqo – environment variable reference
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8080
APP_HOST=localhost

# ── Database (PostgreSQL) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moniqo
DB_USER=moniqo
DB_PASSWORD=changeme
# Optional: override individual fields above with a full DSN
# DATABASE_URL=postgres://moniqo:changeme@localhost:5432/moniqo?sslmode=disable

# ── Auth (JWT) ───────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m         # access token lifetime (default: 15m)
REFRESH_TOKEN_TTL=168h       # refresh token lifetime (default: 168h = 7d; Go duration, no 'd' unit)
REFRESH_TOKEN_MAX_AGE=720h   # absolute session cap (default: 720h = 30d; rotation chain cannot exceed this)
BCRYPT_COST=12

# ── Cache (Redis – reserved for later) ───────
# REDIS_URL=redis://localhost:6379/0

# ── Web (Next.js) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── CORS ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Docker Compose overrides ─────────────────
# Only needed when running via docker-compose.
# POSTGRES_* vars configure the postgres service.
# BACKEND_PORT and WEB_PORT control host-side port bindings only; container ports are fixed at 8080/3000.
# JWT_SECRET is required — the compose file will refuse to start without it.
# NOTE: NEXT_PUBLIC_API_URL is inlined at Next.js build time; set it before building the web image, not at runtime.
# NOTE: The web Dockerfile requires output: standalone in next.config.
POSTGRES_DB=moniqo
POSTGRES_USER=moniqo
POSTGRES_PASSWORD=changeme   # CHANGE THIS — never use the default in any real environment
POSTGRES_PORT=5432
BACKEND_PORT=8080
WEB_PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# ── Mailpit (local email testing) ────────────
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── Production / reverse proxy ───────────────
# The production stack (Caddy reverse proxy + internal-only web/backend/db) has
# its own compose file and env template under deployment/. See
# deployment/.env.example for DOMAIN, ACME_EMAIL, SMTP, and related variables.
